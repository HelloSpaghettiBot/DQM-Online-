config_version=5

[application]
config/name="DQMOnline"
config/version="0.2.5-alpha"
config/icon="res://assets/icon.svg"
boot_splash/image="res://assets/boot-splash.png"
boot_splash/bg_color=Color(0.063, 0.039, 0.102, 1)
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.025,0.04,0.055,1)

[input_devices]
pointing/emulate_mouse_from_touch=true

[audio]
driver/enable_input=false

[network]
limits/encode_buffer_max_size=1048576

[configuration]
entry_symbol = "dqmcore_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://bin/libdqmcore.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libdqmcore.linux.template_release.x86_64.so"
android.debug.arm64 = "res://bin/libdqmcore.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libdqmcore.android.template_release.arm64.so"
windows.debug.x86_64 = "res://bin/libdqmcore.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libdqmcore.windows.template_release.x86_64.dll"

[dependencies]
linux.debug.x86_64 = { "res://bin/libgambatte_libretro.so": "" }
linux.release.x86_64 = { "res://bin/libgambatte_libretro.so": "" }
android.debug.arm64 = { "res://bin/android/arm64/libretro.so": "" }
android.release.arm64 = { "res://bin/android/arm64/libretro.so": "" }
windows.debug.x86_64 = { "res://bin/windows/gambatte_libretro.dll": "" }
windows.release.x86_64 = { "res://bin/windows/gambatte_libretro.dll": "" }
